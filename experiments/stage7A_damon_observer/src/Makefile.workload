CC ?= gcc
CFLAGS ?= -std=c11 -O2 -Wall -Wextra -Werror -pedantic
BIN_DIR ?= ../bin
TARGET := $(BIN_DIR)/damon_access_pattern_workload

.PHONY: all clean

all: $(TARGET)

$(TARGET): damon_access_pattern_workload.c | $(BIN_DIR)
	$(CC) $(CFLAGS) -pthread -o $@ $<

$(BIN_DIR):
	mkdir -p $@

clean:
	rm -f $(TARGET)

